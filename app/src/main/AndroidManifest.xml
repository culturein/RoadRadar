<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 개인정보 설계: INTERNET 권한을 선언하지 않는다. 데이터는 차량 밖으로 나갈 수 없다. -->

    <!-- AAOS 표준 차량 속성 (읽기) -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" /> <!-- 외기온도 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />                <!-- 차속 -->
    <uses-permission android:name="android.car.permission.CAR_DYNAMICS_STATE" />       <!-- ABS·TCS·ESC -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />           <!-- 기어 -->
    <uses-permission android:name="android.car.permission.READ_WINDSHIELD_WIPERS" />   <!-- 와이퍼 -->
    <uses-permission android:name="android.car.permission.READ_ADAS_STATES" />         <!-- ESC 상태 -->

    <!-- Pleos Vehicle SDK (Vehicle Service, protectionLevel=normal) -->
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />
    <uses-permission android:name="pleos.car.permission.CAR_TIRES" />
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoadRadar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.RoadRadar">
            <!-- 주행 중에도 표시되는 화면: 주행 중에는 신호등·음성만 보여주도록 설계 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
